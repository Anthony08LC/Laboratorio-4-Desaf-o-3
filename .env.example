# Copia este archivo como .env y completa tus claves. Nunca subas .env al repositorio.
# Si una clave queda vacía, la app funciona en modo SIMULADO para ese servicio.

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: modelo de Gemini (por defecto gemini-3.6-flash)
GEMINI_MODEL=

# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Opcional: id de voz (por defecto 21m00Tcm4TlvDq8ikWAM)
ELEVENLABS_VOICE_ID=

# Opcional: resúmenes que guarda el historial de la sesión (por defecto 5)
MAX_HISTORY=5
